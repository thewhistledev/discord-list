<div class="bot-card">
    <figure class="image is-64x64 bc-avatar is-avatar">
    <img width="64" height="64" class="is-rounded" loading="lazy" src="<%= server.iconURL %>" alt="<%= server.name %> Icon" data-image-fallback="/assets/img/bot/profile.svg">
    </figure>
     <span class="username">
    <span><%= server.name %></span>
    </span>
     <div class="bc-content has-background-dark" 
    data-style="placeholder-background">
    <br />
    <br />
    <br />
       <div class="description has-background-dark is-curved" data-style="card-description">
        <p data-style="card-description-text"><%= server.short %></p>
       </div>
       <div class="bc-buttons">
    <a href="/servers/<%= server.id %>" class="box button is-info is-outlined">
    <span class="icon">
    <i class="fad fa-newspaper has-text-info"></i>
    </span>
    <span>View</span>
    </a>
     <a href="/servers/<%= server.id %>/join" target="_blank" class="box button is-link is-outlined">
    <span class="icon">
    <i class="fad fa-angle-down has-text-link"></i>
    </span>
    <span>Join</span>
    </a>
        </div>
     </div>
    </div>